# Copy to a private local env file before starting the local sidecar.
# Keep this value in sync with samples/codex/agent.codex-sidecar.yml.

CODEX_SIDECAR_HOST=127.0.0.1
CODEX_SIDECAR_PORT=3217
CODEX_SIDECAR_BEARER=airicraft-local-sidecar-token
# Non-loopback hosts require CODEX_SIDECAR_ALLOW_NON_LOOPBACK=true.

# Use a dedicated Codex home so this planner runtime does not share config,
# logs, history, auth files, or caches with your normal interactive Codex use.
# The directory must exist before Codex starts.
CODEX_SIDECAR_CODEX_HOME=/tmp/airicraft-codex-sidecar-home
# Copy samples/codex/airicraft-planner.config.toml to
# "$CODEX_SIDECAR_CODEX_HOME/config.toml" before starting the sidecar.
# The launcher refuses the default ~/.codex home unless
# CODEX_SIDECAR_ALLOW_DEFAULT_CODEX_HOME=true is set.

# Use a neutral working directory for the sidecar process. The HTTP request body
# carries the planner context, so the sidecar should not depend on repo-local
# thread state or project guidance.
CODEX_SIDECAR_CODEX_CWD=/tmp/airicraft-codex-sidecar-workdir

# Optional: set when you want to override the model selected by the Codex
# config. Leave empty to let airicraft-planner.config.toml choose the model.
CODEX_SIDECAR_CODEX_MODEL=

CODEX_SIDECAR_REQUEST_TIMEOUT_MS=120000
CODEX_SIDECAR_STARTUP_TIMEOUT_MS=15000
CODEX_SIDECAR_CODEX_SANDBOX=read-only
CODEX_SIDECAR_CODEX_APPROVAL_POLICY=never
