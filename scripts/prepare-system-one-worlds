#!/usr/bin/env python3
"""Prepare independently seeded configuration-only worlds from the frozen evaluation protocol."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess

ROOT = Path(__file__).resolve().parents[1]


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--split", choices=["development", "held-out", "all"], default="development")
    parser.add_argument("--verify", action="store_true", help="Verify existing archives and provenance without replacing them.")
    args = parser.parse_args()
    protocol = ROOT / "docs/evaluations/system-one-seeded-v1.json"
    spec = json.loads(protocol.read_text())
    template = ROOT / spec["template"]
    if sha(template) != spec["templateSha256"]:
        raise ValueError("Reference archive differs from the frozen protocol")
    properties = dict(re.findall(r"^([^#=\s]+)=(.*)$", (ROOT / "gradle.properties").read_text(), re.M))
    if properties["minecraft_version"] != spec["minecraftVersion"]:
        raise ValueError("Minecraft version differs from the frozen protocol")
    cache = Path(os.environ.get("GRADLE_USER_HOME", str(Path.home() / ".gradle"))) / "caches/fabric-loom/minecraftMaven/net/minecraft/minecraft-common"
    jars = list(cache.glob(f"{spec['minecraftVersion']}-net.fabricmc.yarn.*{properties['yarn_mappings']}-v2/*.jar"))
    if len(jars) != 1:
        raise ValueError("Expected one prepared Yarn Minecraft common jar; run the project build first")
    classpath = (ROOT / ".gradle/loom-cache/remapClasspath.txt").read_text().strip() + os.pathsep + str(jars[0])
    source = ROOT / "scripts/java/FreshEvaluationWorld.java"
    for world in spec["worlds"]:
        if args.split != "all" and world["split"] != args.split:
            continue
        name, seed = world["id"], world["seed"]
        if not re.fullmatch(r"iron-pickaxe-(development|held-out)-\d{2}", name):
            raise ValueError("Invalid frozen scenario identifier")
        directory = ROOT / "scenarios" / name
        archive = directory / "world.zip"
        command = ["java", "-cp", classpath, str(source)]
        if args.verify:
            proof = json.loads((directory / "generation.json").read_text())
            if (proof["worldSha256"] != sha(archive) or proof["protocolSha256"] != sha(protocol)
                    or proof["scenarioSha256"] != sha(directory / "scenario.yml")
                    or proof["preparerSha256"] != sha(source) or proof["minecraftJarSha256"] != sha(jars[0])):
                raise ValueError(f"Frozen artifact mismatch: {name}")
            subprocess.run([*command, "--verify", str(archive), str(seed)], check=True)
            continue
        directory.mkdir()  # Existing frozen inputs must never be silently replaced.
        subprocess.run([*command, str(template), str(archive), str(seed), name], check=True)
        budget = spec["budgets"]
        scenario = f'''id: {name}
name: Independent {world['split']} iron pickaxe {name[-2:]}
metadata:
  minecraftVersion: {spec['minecraftVersion']}
  airicraftVersion: dev
worldArchive: world.zip
frozen: true
prompt: Obtain one iron pickaxe from an empty inventory in this independently seeded world.
goal:
  kind: inventory_item
  itemId: minecraft:iron_pickaxe
  quantity: 1
budget:
  maxPlannerTurns: {budget['maxPlannerTurns']}
  maxElapsedTicks: {budget['maxElapsedTicks']}
  maxElapsedMillis: {budget['maxElapsedMillis']}
  heartbeatIntervalTicks: {budget['heartbeatIntervalTicks']}
checks:
  - type: inventory_contains
    itemId: minecraft:iron_pickaxe
    count: 1
evidence:
  includePlannerJournal: true
  includeDebugTimeline: true
  includeRecentEvents: true
  includeTaskState: true
  includeWorldSnapshot: true
'''
        (directory / "scenario.yml").write_text(scenario)
        proof = {"seed": seed, "split": world["split"], "protocolSha256": sha(protocol),
                 "templateSha256": sha(template), "worldSha256": sha(archive),
                 "scenarioSha256": sha(directory / "scenario.yml"), "preparerSha256": sha(source),
                 "minecraftJarSha256": sha(jars[0]), "archiveEntries": ["level.dat"],
                 "terrainGenerated": False, "playerDataPresent": False, "initialized": False}
        (directory / "generation.json").write_text(json.dumps(proof, indent=2) + "\n")
        print(f"Prepared {name}; terrain and natural spawn will be generated by Minecraft on first load.")


if __name__ == "__main__":
    main()
