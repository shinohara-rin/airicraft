#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
command="${1:-run}"
if [[ $# -gt 0 ]]; then
	shift
fi

case "$command" in
	run)
		cd "$repo_root"
		if [[ -f .envrc ]]; then
			# shellcheck disable=SC1091
			source .envrc
		fi
		exec ./gradlew -Pairicraft.includeEvaluator=true -Pairicraft.includeCompat=true :runClientCompatEvaluator "$@"
		;;
	*)
		printf 'usage: scripts/eval run [gradle args...]\n' >&2
		exit 2
		;;
esac
