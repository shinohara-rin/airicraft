#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
command="${1:-run}"
if [[ $# -gt 0 ]]; then
	shift
fi

usage() {
	cat <<'USAGE'
usage: scripts/eval run [gradle args...]

run launches the HotSwap compatibility client with the evaluator addon.
Run ./gradlew hotswapMain --continuous in a second terminal to reload main-mod classes.
Evaluator-addon and compatibility-addon changes still need a client restart.
USAGE
}

disable_journeymap_minimap_for_evaluator() {
	local game_dir="$1"
	local config_dir="$game_dir/journeymap/config/6.0"
	local config_file
	mkdir -p "$config_dir"
	for config_file in "$config_dir"/journeymap.minimap.config "$config_dir"/journeymap.minimap2.config; do
		cat >"$config_file" <<'EOF'
// Airicraft evaluator disables the JourneyMap HUD minimap to keep headless smoke runs stable.
{
  "enabled": "false",
  "moveEffectIcons": "false",
  "hideEffectIcons": "true",
  "active": false,
  "configVersion": "6.0.0-beta.52"
}
EOF
	done
}

case "$command" in
	run)
		cd "$repo_root"
		if [[ -f .envrc ]]; then
			# shellcheck disable=SC1091
			source .envrc
		fi
		game_dir="${AIRICRAFT_EVALUATOR_GAME_DIR:-$repo_root/run}"
		if [[ "$game_dir" != /* ]]; then
			printf 'AIRICRAFT_EVALUATOR_GAME_DIR must be an absolute path\n' >&2
			exit 2
		fi
		disable_journeymap_minimap_for_evaluator "$game_dir"
		gradle_args=(
			"-Pairicraft.evaluator.runDir=$game_dir"
			"-Pairicraft.evaluator.jdwp.enabled=${AIRICRAFT_EVALUATOR_JDWP_ENABLED:-true}"
			"-Pairicraft.evaluator.runtimePrepared=${AIRICRAFT_EVALUATOR_RUNTIME_PREPARED:-false}"
		)
		if [[ -n "${AIRICRAFT_EVALUATOR_PLAYER_NAME:-}" ]]; then
			gradle_args+=("-Pairicraft.devPlayerName=$AIRICRAFT_EVALUATOR_PLAYER_NAME")
		fi
		if [[ -n "${AIRICRAFT_RECORDER_JAR:-}" ]]; then
			gradle_args+=("-Pairicraft.evaluator.recorderJar=$AIRICRAFT_RECORDER_JAR")
		fi
		exec ./gradlew "${gradle_args[@]}" -Pairicraft.includeEvaluator=true -Pairicraft.includeCompat=true :runClientCompatEvaluator "$@"
		;;
	-h | --help | help)
		usage
		exit 0
		;;
	*)
		usage >&2
		exit 2
		;;
esac
