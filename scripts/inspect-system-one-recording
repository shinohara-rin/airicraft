#!/usr/bin/env python3
"""Summarize saved decision evidence without Minecraft or a matching policy checkout.

Coverage checks do not verify decisions. Use replaySystemOne for that separate check.
"""
import argparse
from collections import Counter, deque
import gzip
import json
import math
from pathlib import Path
import re


class RecordingMetrics:
    """Observed measurements only; missing samples never imply zero risk."""

    def __init__(self):
        self.previous = None
        self.samples = self.vital_samples = self.travel_segments = 0
        self.distance = self.health_decrease = 0.0
        self.minimum_health = None
        self.dead_lives = set()
        self.burning_samples = self.lava_samples = 0
        self.suspensions = Counter()
        self.resumptions = Counter()
        self.task_outcomes = Counter()
        self.lighting_turns = self.allowance_samples = self.active_allowance_samples = self.expired_active_samples = 0
        self.allowance_instances = set()
        self.active_mission_tasks = Counter()
        self.expired_mission_samples = 0
        self.recent_allowances = deque(maxlen=8)

    def lighting(self, tick, trace):
        if trace is None:
            return
        self.lighting_turns += 1
        for frame in trace["before"] + trace["after"]:
            allowance = frame.get("allowance")
            if allowance:
                origin = allowance["origin"]
                identity = (frame["task"], *(origin[axis] for axis in ("x", "y", "z")), allowance["expiresAt"])
                if identity not in self.allowance_instances:
                    self.allowance_instances.add(identity)
                    self.recent_allowances.append({"first_recorded_tick": tick, "task": frame["task"], **allowance})
        for frame in trace["after"]:
            allowance = frame.get("allowance")
            if not allowance:
                continue
            self.allowance_samples += 1
            if frame["leaf"] and frame["phase"] == "Acting" and frame["continuation"] == ["explore"]:
                self.active_allowance_samples += 1
                self.expired_active_samples += tick >= allowance["expiresAt"]
            if "mission" in frame["continuation"] and frame.get("activityPhase") == "Acting" and not frame.get("repairing", False):
                self.active_mission_tasks[frame["activity"]] += 1
                self.expired_mission_samples += tick >= allowance["expiresAt"]

    def lighting_report(self, coverage, turns):
        if not self.lighting_turns:
            return {"status": "unavailable", "reason": "Lighting policy state is not serialized in this recording format."}
        return {
            "status": "recorded_policy_state", "coverage": coverage,
            "recorded_turns": self.lighting_turns, "missing_turns": turns - self.lighting_turns,
            "instances_observed": len(self.allowance_instances), "allowance_state_samples": self.allowance_samples,
            "active_exploration_state_samples": self.active_allowance_samples,
            "expired_active_exploration_samples": self.expired_active_samples,
            "active_mission_samples_by_task": dict(sorted(self.active_mission_tasks.items())),
            "expired_active_mission_samples": self.expired_mission_samples,
            "recent_instances": list(self.recent_allowances),
            "actual_dark_exposure_ticks": None,
            "definition": "Snapshots describe policy state, not physical dark exposure. Legacy exploration samples require an acting Explore leaf. Mission samples classify the acting task while excluding repair branches; expired samples may include an inventory transaction draining before interruption. Counts use post-decision state; deadline instances use both before and after state.",
        }

    def observe(self, tick, observation):
        if observation is None:
            self.previous = None
            return
        self.samples += 1
        vitals = observation.get("vitals")
        if vitals:
            self.vital_samples += 1
            health = vitals["health"]
            self.minimum_health = health if self.minimum_health is None else min(self.minimum_health, health)
            if health <= 0:
                self.dead_lives.add(vitals["life"])
            self.burning_samples += bool(vitals.get("burning"))
            self.lava_samples += bool(vitals.get("inLava"))
            if self.previous:
                previous_tick, previous = self.previous
                old_vitals = previous.get("vitals")
                if old_vitals and previous_tick + 1 == tick and old_vitals["life"] == vitals["life"]:
                    self.health_decrease += max(0, old_vitals["health"] - health)
                    eye, old_eye = observation.get("eye"), previous.get("eye")
                    if eye and old_eye:
                        self.distance += math.hypot(eye["x"] - old_eye["x"], eye["z"] - old_eye["z"])
                        self.travel_segments += 1
        self.previous = (tick, observation)

    def event(self, kind, detail):
        if kind == "task_suspended":
            self.suspensions[detail] += 1
        elif kind == "task_resumed":
            self.resumptions[detail] += 1
        elif kind == "task_ended":
            self.task_outcomes[detail] += 1

    def report(self, coverage, turns, commands):
        return {
            "coverage": coverage,
            "observation_samples": self.samples,
            "missing_observation_turns": turns - self.samples,
            "travel": {
                "horizontal_observed_blocks": round(self.distance, 3) if self.travel_segments else None,
                "adjacent_same_life_segments": self.travel_segments,
                "definition": "Sum of horizontal displacement between consecutive observed poses in the same life; excludes sample gaps and respawns, includes any same-life teleport.",
            },
            "excavation": {
                "break_commands_started": commands.get("Break", 0),
                "blocks_destroyed": None,
                "definition": "Attempts measure issued work; command success does not prove that the agent destroyed a block.",
            },
            "survival": {
                "vital_samples": self.vital_samples,
                "minimum_observed_health": self.minimum_health,
                "observed_health_decrease": round(self.health_decrease, 3) if self.vital_samples else None,
                "lives_observed_dead": len(self.dead_lives) if self.vital_samples else None,
                "burning_samples": self.burning_samples if self.vital_samples else None,
                "in_lava_samples": self.lava_samples if self.vital_samples else None,
                "definition": "Health decrease is the sum of adjacent same-life net decreases, not total damage; death count includes only lives observed at health <= 0.",
            },
            "task_suspensions": dict(sorted(self.suspensions.items())),
            "task_resumptions": dict(sorted(self.resumptions.items())),
            "task_outcomes": dict(sorted(self.task_outcomes.items())),
            "dark_exposure_allowance": self.lighting_report(coverage, turns),
            "perception_violations": {"status": "unavailable", "count": None, "reason": "Decision replay and trace coverage do not audit sensor or motor hidden reads."},
        }


class BreakObservationAudit:
    """Check recorded target identity and time; not visibility or engine read authority."""

    COMMAND = re.compile(r"command=Break\[target=Pos\[x=(-?\d+), y=(-?\d+), z=(-?\d+)\], expectedBlock=([^\]]+)\]\]$")

    def __init__(self):
        self.checked = self.mismatched = self.missing = 0
        self.missing_input_turns = 0
        self.unclassified_effects = 0
        self.reasons = Counter()
        self.examples = deque(maxlen=12)

    def observe(self, observation):
        if observation is not None and not all(isinstance(observation.get(k), list) for k in ("changed", "removed")):
            self.missing_input_turns += 1

    def check(self, tick, effect, observation, known):
        match = self.COMMAND.search(effect)
        evidence = {"tick": tick}
        if not match:
            reason, missing = "unparsed_break_command", True
        elif observation is None or not all(isinstance(observation.get(k), list) for k in ("changed", "removed")):
            reason, missing = "missing_observation_input", True
        elif self.missing_input_turns:
            reason, missing = "incomplete_observation_history", True
        else:
            target = tuple(int(match[i]) for i in (1, 2, 3))
            expected = match[4]
            seen = known.get(target)
            evidence.update(target=dict(zip(("x", "y", "z"), target)), expected_block=expected)
            if seen is None:
                reason, missing = "unknown_target", False
            elif (not isinstance(seen.get("blockId"), str) or type(seen.get("identified")) is not bool
                  or type(seen.get("empty")) is not bool or type(seen.get("tick")) is not int):
                reason, missing = "missing_observation_fields", True
            else:
                evidence.update(observed_block=seen["blockId"], observed_at=seen["tick"])
                missing = False
                if not seen["identified"] or seen["empty"]:
                    reason = "target_not_identified_occupied"
                elif seen["blockId"] != expected:
                    reason = "target_identity_mismatch"
                elif seen["tick"] > tick:
                    reason = "future_observation"
                else:
                    self.checked += 1
                    return
        self.reasons[reason] += 1
        self.missing += missing
        self.mismatched += not missing
        self.checked += not missing
        self.examples.append({**evidence, "reason": reason})

    def report(self, coverage):
        return {"status": "complete" if coverage == "complete" and not self.missing and not self.missing_input_turns and not self.unclassified_effects else "partial",
                "checked_breaks": self.checked, "mismatched_breaks": self.mismatched,
                "missing_evidence_breaks": self.missing, "missing_input_turns": self.missing_input_turns, "reasons": dict(self.reasons),
                "unclassified_effects": self.unclassified_effects,
                "recent_problems": list(self.examples),
                "scope": "Recorded target identity and observation time only. Does not audit line of sight, light, physical reach, support reservations, sensor reads, or motor reads."}


def apply_observation_delta(known, observation, tick, compact):
    if compact:
        if not all(isinstance(observation.get(k), list) for k in ("changed", "removed", "refreshed")):
            raise ValueError("missing observation delta")
        touched = set()
        for field in ("changed", "removed", "refreshed"):
            for entry in observation[field]:
                pos = entry["pos"] if field == "changed" else entry
                key = tuple(pos[axis] for axis in ("x", "y", "z"))
                if key in touched or field == "refreshed" and key not in known:
                    raise ValueError("unknown or conflicting observation delta")
                touched.add(key)
    for change in observation.get("changed", []):
        known[tuple(change["pos"][axis] for axis in ("x", "y", "z"))] = change["seen"]
    for removed in observation.get("removed", []):
        known.pop(tuple(removed[axis] for axis in ("x", "y", "z")), None)
    for refreshed in observation.get("refreshed", []):
        key = tuple(refreshed[axis] for axis in ("x", "y", "z"))
        known[key] = {**known[key], "tick": tick}


def inspect_recording(path, failure_context=False, audit_breaks=False):
    report = {"recording": str(path), "coverage": "incomplete", "decision_replay": "not_checked"}
    rows = turns = 0
    tick = None
    header = footer = None
    outcome = ""
    problems = []
    inventory = {}
    tasks = {}
    commands = Counter()
    failures = Counter()
    recent = deque(maxlen=12)
    last_failure = None
    first_task_failure = None
    search_rows = 0
    search_counts = Counter()
    search_changes = deque(maxlen=12)
    failed_tasks = 0
    known = {}
    command_history = deque(maxlen=12)
    metrics = RecordingMetrics()
    break_audit = BreakObservationAudit() if audit_breaks else None

    def context(observation):
        if not observation:
            return {}
        feet = observation["feet"]
        nearby = lambda pos: all(abs(pos[axis] - feet[axis]) <= 2 for axis in ("x", "y", "z"))
        return {"position": dict(feet), "eye": observation.get("eye"), "inventory": dict(inventory),
                "nearby_cells": [{"pos": dict(zip(("x", "y", "z"), pos)), "seen": value}
                                 for pos, value in sorted(known.items())
                                 if nearby(dict(zip(("x", "y", "z"), pos)))],
                "nearby_footholds": [pos for pos in observation.get("footholds", []) if nearby(pos)],
                "recent_commands": list(command_history)}

    def chain(task):
        result = []
        seen = set()
        while task in tasks and task not in seen:
            seen.add(task)
            parent, reason = tasks[task]
            result.append({"task": task, "purpose": reason})
            task = parent
        return list(reversed(result))

    try:
        with gzip.open(path, "rt") as stream:
            for line in stream:
                row = json.loads(line)
                kind = row.get("type")
                if footer is not None:
                    problems.append("data_after_footer")
                if kind in ("begin", "production_begin"):
                    if rows:
                        problems.append("repeated_or_late_header")
                    header = row
                    supported = (1, 2, 3) if kind == "production_begin" else (1, 2)
                    if row.get("version", 1) not in supported:
                        raise ValueError("unsupported recording version")
                    tick = row["tick"]
                    goal = f"acquire {row['count']} {row.get('item', 'minecraft:cobblestone')}"
                    tasks[1] = (None, goal)
                    report.update(goal=goal, method_version=row["methodVersion"], run=row["run"])
                elif kind == "turn":
                    if "search" in row:
                        if not isinstance(row["search"], list):
                            raise ValueError("invalid search evidence")
                        search_rows += 1
                        for change in row["search"]:
                            search_counts[change["change"]] += 1
                            search_changes.append({**change, "tick": row["tick"]})
                    turns += 1
                    if header is None or row["sequence"] != turns or tick is None or row["tick"] != tick + 1:
                        problems.append(f"missing_or_reordered_input_at_turn:{turns}")
                    tick = row["tick"]
                    observation = row.get("observation")
                    metrics.observe(tick, observation)
                    if break_audit is not None:
                        break_audit.observe(observation)
                    if observation is None:
                        known.clear()
                    if header and header.get("type") == "production_begin" and header.get("version", 1) >= 2 and row.get("lighting") is None:
                        problems.append(f"missing_lighting_state_at_turn:{turns}")
                    metrics.lighting(tick, row.get("lighting"))
                    if observation:
                        compact = header is not None and header.get("version", 1) >= (3 if header["type"] == "production_begin" else 2)
                        if compact or failure_context or audit_breaks:
                            apply_observation_delta(known, observation, tick, compact)
                        current = observation["inventory"]
                        delta = {item: current.get(item, 0) - inventory.get(item, 0)
                                 for item in sorted(current.keys() | inventory.keys())
                                 if current.get(item, 0) != inventory.get(item, 0)}
                        if delta:
                            recent.append({"tick": tick, "inventory_change": delta})
                        inventory = current
                        report["last_position"] = observation["feet"]
                    for effect in row["effects"]:
                        match = re.search(r"command=(\w+)\[", effect)
                        if match:
                            commands[match[1]] += 1
                            command_history.append({"tick": tick, "effect": effect[:512], "truncated": len(effect) > 512})
                            if break_audit is not None and match[1] == "Break":
                                break_audit.check(tick, effect, observation, known)
                        elif break_audit is not None and not effect.startswith("Stop["):
                            break_audit.unclassified_effects += 1
                    for event in row["events"]:
                        event_kind, detail, task = event["type"], event["detail"], event["task"]
                        metrics.event(event_kind, detail)
                        if event_kind == "task_started":
                            match = re.fullmatch(r"parent=(\d+) reason=(.*)", detail)
                            if match:
                                tasks[task] = (int(match[1]), match[2][:240])
                        elif event_kind == "command_finished" and detail.startswith("FAILED:"):
                            reason = detail.removeprefix("FAILED:")[:240]
                            failures[reason] += 1
                            last_failure = {"tick": tick, "reason": reason, "task_chain": chain(task)}
                        elif event_kind == "task_ended" and detail.startswith("FAILED:"):
                            failed_tasks += 1
                            if first_task_failure is None:
                                first_task_failure = {"tick": tick, "reason": detail.removeprefix("FAILED:")[:240], "task_chain": chain(task)}
                                if failure_context:
                                    first_task_failure["context"] = context(observation)
                                    first_task_failure["context"]["lighting"] = row.get("lighting")
                    outcome = row["outcome"]
                elif kind == "end":
                    footer = row
                    if row.get("rows") != rows:
                        problems.append("footer_row_count_mismatch")
                else:
                    problems.append(f"unexpected_record:{kind}")
                rows += 1
    except (EOFError, OSError, ValueError, KeyError, TypeError) as error:
        problems.append(f"read_error:{type(error).__name__}:{str(error)[:240]}")
    if header is None:
        problems.append("missing_header")
    if footer is None:
        problems.append("missing_footer")
    if not outcome:
        problems.append("missing_terminal_outcome")
    report.update(coverage="complete" if not problems else "incomplete", coverage_problems=problems[:20],
                  turns=turns, last_tick=tick, outcome=outcome[:240], inventory=inventory,
                  commands=dict(sorted(commands.items())), command_failures=dict(failures.most_common(20)),
                  last_command_failure=last_failure, first_task_failure=first_task_failure,
                  search_rejections={"status": "complete" if turns and search_rows == turns else "partial" if search_rows else "unavailable",
                                     "counts": dict(search_counts), "recent_changes": list(search_changes)},
                  failed_tasks=failed_tasks, recent_inventory_changes=list(recent))
    report["metrics"] = metrics.report(report["coverage"], turns, commands)
    if break_audit is not None:
        report["metrics"]["break_target_observations"] = break_audit.report(report["coverage"])
    return report


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("recording", type=Path)
    parser.add_argument("--failure-context", action="store_true", help="Include the first failed task's observed local cells, inventory, and recent commands.")
    parser.add_argument("--audit-break-observations", action="store_true", help="Check each break's recorded target identity and observation tick; does not audit hidden reads.")
    args = parser.parse_args()
    report = inspect_recording(args.recording, args.failure_context, args.audit_break_observations)
    print(json.dumps(report, indent=2))
    return 0 if report["coverage"] == "complete" else 2


if __name__ == "__main__":
    raise SystemExit(main())
