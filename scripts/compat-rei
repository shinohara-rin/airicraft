#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

if [[ -f .envrc ]]; then
  source .envrc
fi

command="${1:-run}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$command" in
  setup | sync)
    ./gradlew -Pairicraft.includeReiCompat=true :compat:rei:syncReiCompatMods :compat:rei:syncReiCompatLibraries "$@"
    ;;
  run)
    ./gradlew -Pairicraft.includeReiCompat=true :compat:rei:runClientReiCompat "$@"
    ;;
  dry-run)
    ./gradlew -Pairicraft.includeReiCompat=true :compat:rei:runClientReiCompat --dry-run "$@"
    ;;
  config)
    mkdir -p run/config/airicraft
    printf '%s\n' "$repo_root/run/config/airicraft"
    ;;
  mods | list)
    ./gradlew -Pairicraft.includeReiCompat=true -q :compat:rei:syncReiCompatMods :compat:rei:syncReiCompatLibraries
    find .airicraft-compat/rei/mods -maxdepth 1 -type f -name '*.jar' -print | sort
    find .airicraft-compat/rei/libraries -maxdepth 1 -type f -name '*.jar' -print | sort
    ;;
  *)
    cat >&2 <<'USAGE'
usage: scripts/compat-rei [setup|sync|run|dry-run|config|mods|list] [gradle args...]

setup   build Airicraft and sync the REI compatibility mods folder
run     launch the debug production-style REI client with shared run/ config
dry-run print the Gradle task graph without launching Minecraft
config  print the shared Airicraft config directory
mods    sync and list the jars in .airicraft-compat/rei/{mods,libraries}
USAGE
    exit 2
    ;;
esac
