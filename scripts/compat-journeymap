#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

if [[ -f .envrc ]]; then
  source .envrc
fi

command="${1:-run}"
if [[ $# -gt 0 ]]; then
  shift
fi

gradle_base=(./gradlew -Pairicraft.includeJourneyMapCompat=true -Pairicraft.includeReiCompat=true)

case "$command" in
  setup | sync)
    "${gradle_base[@]}" :compat:journeymap:syncJourneyMapCompatMods :compat:journeymap:syncJourneyMapCompatLibraries "$@"
    ;;
  run)
    "${gradle_base[@]}" :compat:journeymap:runClientJourneyMapCompat "$@"
    ;;
  dry-run)
    "${gradle_base[@]}" :compat:journeymap:runClientJourneyMapCompat --dry-run "$@"
    ;;
  config)
    mkdir -p run/config/airicraft
    printf '%s\n' "$repo_root/run/config/airicraft"
    ;;
  mods | list)
    "${gradle_base[@]}" -q :compat:journeymap:syncJourneyMapCompatMods :compat:journeymap:syncJourneyMapCompatLibraries
    find .airicraft-compat/journeymap/mods -maxdepth 1 -type f -name '*.jar' -print | sort
    find .airicraft-compat/journeymap/libraries -maxdepth 1 -type f -name '*.jar' -print | sort
    ;;
  *)
    cat >&2 <<'USAGE'
usage: scripts/compat-journeymap [setup|sync|run|dry-run|config|mods|list] [gradle args...]

setup   build Airicraft and sync the JourneyMap+REI compatibility mods folder
run     launch the debug production-style JourneyMap+REI client with shared run/ config
dry-run print the Gradle task graph without launching Minecraft
config  print the shared Airicraft config directory
mods    sync and list the jars in .airicraft-compat/journeymap/{mods,libraries}
USAGE
    exit 2
    ;;
esac
